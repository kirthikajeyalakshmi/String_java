
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        String s =in.nextLine();
        int[] pos={1,4};
        StringBuilder sb = new StringBuilder(s);
        char ch='z'; 
        for(int i=pos.length-1;i>=0;i--){
            sb.insert(pos[i],ch);
        }
        System.out.print(sb.toString());
    }
}
