import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        String s = in.nextLine();
        for(int i=s.length()-1;i>=0;i--){
            char ch=s.charAt(i);
            if((ch-'0')%2!=0){
                s=s.substring(0,i+1);
                break;
            }
        }
        System.out.print(s);
    }
}
