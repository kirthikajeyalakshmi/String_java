import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner in =new Scanner(System.in);
        String s=in.nextLine();
        int n=s.length();
        HashSet<Character>vowel=new HashSet<>();
        vowel.add('a');
        vowel.add('e');
        vowel.add('i');
        vowel.add('o');
        vowel.add('u');
        int cnt=0;
        for(int i=0;i<n;i++){
            HashSet<Character>seen=new HashSet<>();
            for(int j=i;j<n;j++){
                if(!vowel.contains(s.charAt(j))) break;
                seen.add(s.charAt(j));
                if(seen.size()==5) cnt++;
            }
        }
        System.out.print(cnt);
        
    }
}
